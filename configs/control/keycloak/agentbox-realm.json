{
  "realm": "agentbox",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 3,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to the Agentbox console"
      },
      {
        "name": "approver",
        "description": "Can decide permission requests and work alerts"
      },
      {
        "name": "admin",
        "description": "Full console administration"
      }
    ]
  },
  "users": [
    {

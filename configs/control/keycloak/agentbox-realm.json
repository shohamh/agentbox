      "firstName": "Bob",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "Passw0rd!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "erin",
      "enabled": true,

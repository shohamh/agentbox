#!/bin/sh
# Points the corporate control-plane names at the uplink. In the Hyper-V setup the
# control plane is reached through the host over vsock: agentbox-uplink listens on
# 127.0.0.2 for each control-plane port and the host service relays it. In a
# datacenter the names resolve through DNS and this step does nothing
# (agentbox.no_site=1 on the kernel command line). agentbox.host=<ip> overrides the
# address, for tests that run the control plane on a reachable network.
set -u
grep -q 'agentbox.no_site=1' /proc/cmdline && exit 0
TARGET=$(sed -n 's/.*agentbox\.host=\([^ ]*\).*/\1/p' /proc/cmdline)
[ -n "$TARGET" ] || TARGET=127.0.0.2
touch /etc/hosts
sed -i '/# agentbox-site/d' /etc/hosts
grep -q localhost /etc/hosts || echo "127.0.0.1 localhost" >> /etc/hosts
for n in enroll permsvc gw tel registry ca kc; do echo "$TARGET $n.agentbox.corp # agentbox-site" >> /etc/hosts; done
echo "control-plane names point at $TARGET"

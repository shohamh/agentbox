# ---- secrets and key material (generated by scripts/bootstrap.sh; never commit) ----
/deploy/compose/.secrets/
/deploy/compose/.state/
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example

# ---- build outputs ----
/bin/
/dist/
/web/console/dist/
*.exe
*.test
*.out
coverage.out

# ---- appliance and VM images ----
*.vhdx
*.raw
*.qcow2
/image/.build/
/image/tools/*.tmp

# ---- test output ----
/test/results/
/test/results-failed-run*/
/test/ui/test-results/
/test/ui/playwright-report/

# ---- dependencies ----
node_modules/
vendor/

# ---- logs and scratch ----
*.log
tmp/
.tmp/

# ---- editors and operating systems ----
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
